# ─── API ────────────────────────────────────────────────────────────────────
# Server-side only, and unused by the static build. See
# docs/00-architecture.md §3.3.
API_INTERNAL_URL=http://localhost:4000

# The origin the browser calls, absolute. Leave it empty for the web build:
# requests then go to the relative path /api/v1/*, which keeps the refresh
# cookie first-party and alive on iOS Safari.
#
# The native build has to set it. `output: 'export'` drops rewrites, so there is
# no proxy to hide behind and the app talks to the API directly — which also
# means this origin must appear in the API's CORS_ORIGINS.
#
# Put it in `.env.production.local`, not `.env.local`. `next dev` reads
# `.env.local` too, and an absolute URL there moves the dev server off its
# same-origin proxy and makes the refresh cookie third-party — which is the
# exact problem next.config.ts's rewrite exists to avoid.
NEXT_PUBLIC_API_URL=

# ─── Map (Phase 5) ──────────────────────────────────────────────────────────
# Which basemap to render: goong | openfreemap. Leave it empty to decide by
# key — Goong when one is set, the keyless basemap in development, and a hard
# failure in a production build with neither.
#
# Set it to openfreemap to run with no map account at all. That is what the iOS
# build does: a WebView has no domain, so the referrer restriction that protects
# a web maptiles key does not apply, and a key inside an .ipa is an
# unrestricted key.
NEXT_PUBLIC_MAP_PROVIDER=

# The MAPTILES key only. It is public by necessity — the browser fetches tiles
# directly — so restrict it to your domains in the Goong console.
#
# The Goong REST key must NEVER appear here. It is metered and drainable, and
# lives exclusively in gonoplan-api. Anything prefixed NEXT_PUBLIC_ is compiled
# into the client bundle and readable by anyone.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# ─── Analytics (Phase 12) ───────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ENABLED=false
