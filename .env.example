# ─── API ────────────────────────────────────────────────────────────────────
# Server-side only, and unused by the static build. See
# docs/00-architecture.md §3.3.
API_INTERNAL_URL=http://localhost:4000

# The API's absolute origin, for the iOS app only.
#
# In a browser the app always calls the relative path /api/v1/* — the dev
# server's rewrite or the host's proxy forwards it — and ignores this value.
# The iOS bundle is served from capacitor://localhost with nothing behind it to
# proxy through, so it calls the API here directly (and that origin needs no
# CORS entry: it is capacitor://localhost, already allowed).
#
# Put it in `.env.production.local`, which the iOS build reads and `next dev`
# does not.
NEXT_PUBLIC_API_URL=

# ─── The hosted web app's API proxy (Vercel project settings, not this file) ─
# vercel.json forwards /api/v1/* to the API, so in a browser the app only ever
# talks to its own origin and the refresh cookie stays first-party. A browser
# ignores NEXT_PUBLIC_API_URL entirely (src/lib/api/client.ts); only the iOS
# app uses it.
#
# Set GONOPLAN_PROXY_SECRET as a Vercel environment variable — the same value
# as the API's PROXY_SECRET. Vercel adds it to every forwarded request so the
# API can rate-limit per visitor. It is read by Vercel's router, not by the
# build, and must never be NEXT_PUBLIC_.

# ─── Map (Phase 5) ──────────────────────────────────────────────────────────
# Which basemap to render: goong | openfreemap. Leave it empty to decide by
# key — Goong when one is set, the keyless basemap in development, and a hard
# failure in a production build with neither.
#
# Set it to openfreemap to run with no map account at all. That is what the iOS
# build does: a WebView has no domain, so the referrer restriction that protects
# a web maptiles key does not apply, and a key inside an .ipa is an
# unrestricted key.
NEXT_PUBLIC_MAP_PROVIDER=

# The MAPTILES key only. It is public by necessity — the browser fetches tiles
# directly — so restrict it to your domains in the Goong console.
#
# The Goong REST key must NEVER appear here. It is metered and drainable, and
# lives exclusively in gonoplan-api. Anything prefixed NEXT_PUBLIC_ is compiled
# into the client bundle and readable by anyone.
NEXT_PUBLIC_GOONG_MAPTILES_KEY=

# ─── Analytics (Phase 12) ───────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ENABLED=false

# ─── Links that leave the app ───────────────────────────────────────────────
# Where the web app is served, with no trailing slash. Used to build the link
# for a shared plan.
#
# Leave it empty on the web: the page's own origin is right by definition. The
# native build has to set it — inside the iOS app the origin is
# capacitor://localhost, and a link starting with that opens nothing on
# anybody else's phone.
NEXT_PUBLIC_SITE_URL=
