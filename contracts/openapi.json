{
  "openapi": "3.1.0",
  "info": {
    "title": "Gonoplan API",
    "version": "1.0.0",
    "description": "Location discovery platform. Generated from the Zod schemas that validate requests at runtime — do not edit by hand."
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Same-origin (via the web app rewrite proxy)"
    },
    {
      "url": "http://localhost:4000/api/v1",
      "description": "Local development"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Liveness and readiness probes"
    },
    {
      "name": "Auth",
      "description": "Registration, login, token rotation"
    },
    {
      "name": "Places",
      "description": "Discovery, detail, submission"
    },
    {
      "name": "Reviews",
      "description": "Ratings, reviews, replies"
    },
    {
      "name": "Recommendations",
      "description": "Ranked discovery feeds"
    },
    {
      "name": "Geo",
      "description": "Geocoding and routing proxy"
    },
    {
      "name": "Owner",
      "description": "Business owner dashboard"
    },
    {
      "name": "Admin",
      "description": "Moderation and analytics"
    }
  ],
  "components": {
    "schemas": {
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [
              false
            ]
          },
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "details": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "message"
                  ]
                }
              },
              "requestId": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message",
              "requestId"
            ]
          }
        },
        "required": [
          "success",
          "error"
        ]
      },
      "HealthReport": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "service": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "environment": {
            "type": "string"
          },
          "uptimeSeconds": {
            "type": "number"
          },
          "timestamp": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "object",
                "properties": {
                  "reachable": {
                    "type": "boolean"
                  },
                  "latencyMs": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "postgisVersion": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "error": {
                    "type": "string"
                  }
                },
                "required": [
                  "reachable",
                  "latencyMs",
                  "postgisVersion"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "service",
          "version",
          "environment",
          "uptimeSeconds",
          "timestamp",
          "checks"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe",
        "description": "Returns 200 while the process is running. Touches no dependencies.",
        "responses": {
          "200": {
            "description": "Process is alive",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string",
                          "enum": [
                            "ok"
                          ]
                        },
                        "timestamp": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "status",
                        "timestamp"
                      ]
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "total": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "500": {
            "description": "Internal error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe",
        "description": "Verifies the database is reachable and PostGIS is available. Returns 503 when degraded — a database without PostGIS cannot serve any discovery query.",
        "responses": {
          "200": {
            "description": "Ready to serve traffic",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthReport"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "total": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Degraded — database or PostGIS unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "data": {
                      "$ref": "#/components/schemas/HealthReport"
                    },
                    "meta": {
                      "type": "object",
                      "properties": {
                        "cursor": {
                          "type": [
                            "string",
                            "null"
                          ]
                        },
                        "hasMore": {
                          "type": "boolean"
                        },
                        "total": {
                          "type": "number"
                        }
                      }
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
